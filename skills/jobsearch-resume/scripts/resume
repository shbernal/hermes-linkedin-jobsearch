#!/usr/bin/env bash
# resume <build|check|preview|watch> <resume.yaml> [cratecv options]
# Checks the resume's sources against the workspace's profile/, then runs that cratecv command on
# it. Relative paths resolve from the workspace.
set -euo pipefail

if [[ $# -lt 2 ]]; then
  echo "Usage: resume <build|check|preview|watch> <resume.yaml> [cratecv options]" >&2
  exit 2
fi

scripts=$(dirname "$(realpath "$0")")
cd ~/jobsearch
command=$1
resume=$2
shift 2

uv run -q "$scripts/check-resume.py" "$resume" >&2
exec cratecv "$command" "$resume" "$@"
